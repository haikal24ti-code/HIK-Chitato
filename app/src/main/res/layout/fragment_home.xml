<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll_view_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oscardo_cream_bg"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Banner Header Oscardo Service World -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/oscardo_navy_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:strokeColor="@color/oscardo_gold_primary"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_oscardo_banner"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_salon_scissors_comb" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Oscardo Service World"
                        android:textColor="@color/oscardo_gold_bright"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Jelajahi keajaiban layanan salon kami untuk kecantikan dan gaya premium."
                        android:textColor="@color/oscardo_gold_light"
                        android:textSize="13sp" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Action Button 1: Web -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_open_web"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/oscardo_gold_primary"
            android:text="Buka Website Official Salon"
            android:textColor="@color/oscardo_navy_dark"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_web"
            app:iconTint="@color/oscardo_navy_dark" />

        <!-- Quick Action Button 2: Demo -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_open_fourth"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#6B1D2F"
            android:text="Demo"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_interactive"
            app:iconTint="@color/white" />

        <!-- Fitur Pertemuan 11: Main Menu Home dalam Tampilan Grid menggunakan RecyclerView -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Menu Utama Salon:"
            android:textColor="@color/oscardo_text_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_home_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:nestedScrollingEnabled="false" />

        <!-- Fitur Pencarian / Filter Katalog Layanan Salon -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/oscardo_card_cream"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/oscardo_gold_primary"
            app:strokeWidth="1dp">

            <androidx.appcompat.widget.SearchView
                android:id="@+id/search_view_service"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:iconifiedByDefault="false"
                app:queryHint="Cari layanan salon (misal: Potong, Hair)..." />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_catalog_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Katalog Layanan Salon:"
                android:textColor="@color/oscardo_text_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_service"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="@color/oscardo_gold_primary"
                android:paddingHorizontal="12dp"
                android:text="+ Tambah Layanan"
                android:textColor="@color/oscardo_navy_dark"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- Fitur Pertemuan 11: CustomAdapter + ListView untuk Katalog Layanan Salon -->
        <ListView
            android:id="@+id/list_view_services"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:nestedScrollingEnabled="false" />

        <!-- Empty State Teks jika pencarian layanan tidak ditemukan -->
        <TextView
            android:id="@+id/tv_empty_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="Layanan salon yang Anda cari tidak ditemukan."
            android:textColor="@color/oscardo_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>