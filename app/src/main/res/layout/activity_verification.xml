<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oscardo_navy_dark"
    android:orientation="vertical"
    tools:context=".VerificationActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_verification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/oscardo_navy_dark"
        app:navigationIcon="@drawable/ic_back"
        app:title="Verifikasi Data"
        app:titleTextColor="@color/oscardo_gold_bright" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/oscardo_card_cream"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeColor="@color/oscardo_gold_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="Konfirmasi Data Registrasi"
                        android:textColor="@color/oscardo_gold_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Nama -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nama Lengkap"
                        android:textColor="@color/oscardo_gold_dark"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tv_nama"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:backgroundTint="@color/oscardo_navy_dark"
                        android:padding="12dp"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <!-- Email -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email"
                        android:textColor="@color/oscardo_gold_dark"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tv_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:backgroundTint="@color/oscardo_navy_dark"
                        android:padding="12dp"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <!-- Tanggal Lahir -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tanggal Lahir"
                        android:textColor="@color/oscardo_gold_dark"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tv_tgl_lahir"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:backgroundTint="@color/oscardo_navy_dark"
                        android:padding="12dp"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <!-- Jenis Kelamin -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jenis Kelamin"
                        android:textColor="@color/oscardo_gold_dark"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tv_jenis_kelamin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:backgroundTint="@color/oscardo_navy_dark"
                        android:padding="12dp"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <!-- Username -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Username"
                        android:textColor="@color/oscardo_gold_dark"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tv_username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:backgroundTint="@color/oscardo_navy_dark"
                        android:padding="12dp"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <!-- Password -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Password"
                        android:textColor="@color/oscardo_gold_dark"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tv_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:backgroundTint="@color/oscardo_navy_dark"
                        android:padding="12dp"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <!-- Confirm Password -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Konfirmasi Password"
                        android:textColor="@color/oscardo_gold_dark"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tv_confirm_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:backgroundTint="@color/oscardo_navy_dark"
                        android:padding="12dp"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <!-- Tombol Submit -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_submit"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:backgroundTint="@color/oscardo_gold_primary"
                        android:text="Submit"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="28dp" />

                    <!-- Tombol Kembali -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_kembali"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="12dp"
                        android:text="Kembali"
                        android:textColor="@color/oscardo_gold_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="28dp"
                        app:strokeColor="@color/oscardo_gold_primary"
                        app:strokeWidth="2dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>