<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for Salon Oscardo -->
    <style name="Base.Theme.HIKChitato" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color (Navy & Gold) -->
        <item name="colorPrimary">@color/oscardo_navy_dark</item>
        <item name="colorOnPrimary">@color/oscardo_gold_bright</item>
        <item name="colorPrimaryContainer">@color/oscardo_navy_medium</item>
        <item name="colorOnPrimaryContainer">@color/oscardo_gold_light</item>

        <!-- Secondary color (Gold Accent) -->
        <item name="colorSecondary">@color/oscardo_gold_bright</item>
        <item name="colorOnSecondary">@color/oscardo_navy_dark</item>

        <!-- Backgrounds -->
        <item name="android:windowBackground">@color/oscardo_cream_bg</item>

        <!-- Toolbar styling -->
        <item name="toolbarStyle">@style/Widget.Oscardo.Toolbar</item>
    </style>

    <style name="Theme.HIKChitato" parent="Base.Theme.HIKChitato" />

    <style name="Widget.Oscardo.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextColor">@color/oscardo_gold_bright</item>
        <item name="subtitleTextColor">@color/oscardo_gold_light</item>
        <item name="background">@color/oscardo_navy_dark</item>
    </style>
</resources>